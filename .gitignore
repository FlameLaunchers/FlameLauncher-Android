# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.apk
output.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore
# ⚠️ 예외: CI 빌드마다 서명이 달라지는 문제를 막기 위해 고정 release keystore는
#   의도적으로 버전 관리한다(모든 빌드가 항상 같은 서명을 쓰게 하기 위함).
!app/keystore/flamelauncher-release.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# macOS
**/.DS_Store
.DS_Store

# 릴리스 빌드 산출물 (output-metadata.json / baselineProfiles) — 빌드마다 바뀌므로 추적 안 함
app/release/

# ── 비밀 ────────────────────────────────────────────────────────────────────
# CurseForge API 키 등. local.properties 에 두고 BuildConfig 로 넘긴다.
# (local.properties 는 위에서 이미 무시하지만, 별도 파일을 쓰는 경우를 대비해 남긴다)
secrets.properties
keystore.properties

# ── 네이티브 산출물 ─────────────────────────────────────────────────────────
# jniLibs 의 .so 는 **커밋한다** — 빌드 스크립트가 없어서 저장소가 유일한 출처다.
# 그 외 네이티브 빌드 부산물만 무시한다.
.cxx/
obj/

# ── 도구 부산물 ─────────────────────────────────────────────────────────────
*.swp
local.gradle
.kotlin/
